<Window x:Class="S3Browser.Views.InputBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入力"
        Width="380" Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="ValueBox" Grid.Row="1" Padding="4,3"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Height="26" Margin="0,0,8,0"
                    IsDefault="True" Click="OnOk"/>
            <Button Content="キャンセル" Width="80" Height="26"
                    IsCancel="True" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
