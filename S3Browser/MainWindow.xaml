<Window x:Class="S3Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:S3Browser.ViewModels"
        xmlns:m="clr-namespace:S3Browser.Models"
        mc:Ignorable="d"
        Title="S3 Browser"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="OnWindowDrop"
        DragOver="OnWindowDragOver"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style x:Key="ListIconText" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#1F6FEB"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top" Background="#F4F4F4" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding GoBackCommand}"
                            ToolTip="戻る">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding GoForwardCommand}"
                            ToolTip="進む">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72A;"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding NavigateUpCommand}"
                            ToolTip="上の階層">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74A;"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="更新">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;"/>
                    </Button>
                    <Separator Margin="6,4"/>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding UploadCommand}"
                            ToolTip="アップロード">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE898;"/>
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="アップロード"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding DownloadCommand}"
                            ToolTip="ダウンロード">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE896;"/>
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="ダウンロード"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding NewFolderCommand}"
                            ToolTip="新しいフォルダー">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8F4;"/>
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="新規フォルダー"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding NewBucketCommand}"
                            ToolTip="新しいバケット">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE753;"/>
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="新規バケット"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding DeleteCommand}"
                            ToolTip="削除">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;"/>
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="削除"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding ConnectCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE968;"/>
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="接続..."/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Command="{Binding DisconnectCommand}"
                            IsEnabled="{Binding IsConnected}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7E8;"/>
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="切断"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Address bar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Padding="6,4" VerticalContentAlignment="Center"
                         Text="{Binding AddressBarText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnAddressKeyDown"/>
                <Button Grid.Column="1" Margin="6,0,0,0" Padding="14,4"
                        Command="{Binding NavigateToAddressCommand}"
                        Content="移動"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#F4F4F4" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding StatusText}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding ProgressText}"/>
                    <ProgressBar Width="180" Height="14" Minimum="0" Maximum="100" Value="{Binding ProgressValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555"/>
                    <TextBlock VerticalAlignment="Center" Foreground="#333"
                               Text="{Binding CurrentUserDisplay}"
                               ToolTip="現在認証中のIAMユーザー / ロール"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main: tree + list -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tree -->
            <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="0,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="10,8" Background="#EEE">
                        <TextBlock Text="バケット" FontWeight="SemiBold"/>
                    </Border>
                    <TreeView x:Name="BucketsTree" BorderThickness="0"
                              ItemsSource="{Binding TreeRoots}"
                              SelectedItemChanged="OnTreeSelectionChanged">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="#1F6FEB"
                                               Text="{Binding ItemType, Converter={StaticResource ItemIcon}}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#DDD" ResizeBehavior="PreviousAndNext"/>

            <!-- List -->
            <Grid Grid.Column="2">
                <ListView x:Name="ItemsList" BorderThickness="0"
                          ItemsSource="{Binding Items}"
                          SelectionMode="Extended"
                          MouseDoubleClick="OnItemDoubleClick"
                          SelectionChanged="OnListSelectionChanged">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="開く" Click="OnContextOpen"/>
                            <Separator/>
                            <MenuItem Header="ダウンロード..." Command="{Binding DownloadCommand}"/>
                            <MenuItem Header="名前の変更..." Command="{Binding RenameCommand}"/>
                            <MenuItem Header="削除" Command="{Binding DeleteCommand}"/>
                            <Separator/>
                            <MenuItem Header="更新" Command="{Binding RefreshCommand}"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridView.Columns>
                                <GridViewColumn Header="名前" Width="380">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource ListIconText}"
                                                           Text="{Binding ItemType, Converter={StaticResource ItemIcon}}"/>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="更新日時" Width="160" DisplayMemberBinding="{Binding ModifiedDisplay}"/>
                                <GridViewColumn Header="種類" Width="120" DisplayMemberBinding="{Binding TypeDisplay}"/>
                                <GridViewColumn Header="サイズ" Width="120" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                <GridViewColumn Header="ストレージクラス" Width="140" DisplayMemberBinding="{Binding StorageClass}"/>
                            </GridView.Columns>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Border Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                        IsHitTestVisible="False">
                    <TextBlock Text="読み込み中..." Foreground="White" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
