<Application x:Class="S3Browser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:S3Browser.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:S3ItemTypeToIconConverter x:Key="ItemIcon"/>
        <conv:EnumMatchConverter x:Key="EnumMatch"/>
    </Application.Resources>
</Application>
